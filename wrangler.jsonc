{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yousef-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0baf755c-dda9-4ff8-ae31-87178a9b4447","database_name": "yousef-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "622b59657af848a8bca42c4277f35963" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
